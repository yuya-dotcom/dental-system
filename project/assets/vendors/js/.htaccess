# Version-pinned vendor files (the version is in the file name, so the
# content never changes): let browsers cache them for a year.
<IfModule mod_headers.c>
    <FilesMatch "^(sweetalert2-[0-9.]+\.all|fullcalendar-[0-9.]+\.index\.global)\.min\.js$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
